# Processing Service Configuration

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (Shared with Backend/Prisma)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# S3 Object Storage (Neon Object Storage / Cloudflare R2 / AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL_S3=https://ep-sample.pooler.neon.tech
AWS_S3_BUCKET_NAME=logicsense-bucket

# AI Summarization (Gemini API)
GEMINI_API_KEY=your_gemini_api_key
