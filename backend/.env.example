NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/logic_sense?schema=public

# Clerk Authentication & Webhooks
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3="https://<project-storage-id>.storage.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_placeholder"
AWS_SECRET_ACCESS_KEY="nsk_live_placeholder"
AWS_REGION="us-east-2"
STORAGE_BUCKET_NAME="logicsense-bucket"

JWT_ACCESS_SECRET=your_access_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Allowed Origins (Comma-separated origins or * for all)
CORS_ORIGIN="http://localhost:3000,https://*.vercel.app,*"

# AI Incident Summarization (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
